MONGODB_URI=
PORT=3004
# localhost on your own machine; 0.0.0.0 on a host, so it can reach the server
SERVER_HOST=localhost

# The address of the web app: links in emails point there
FRONTEND_URL=http://localhost:5178

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Email, option 1: SMTP (works locally and on hosts that allow outgoing mail ports)
MAIL_HOST=
EMAIL_PORT=
MAIL_USER=
MAIL_PASS=

# Email, option 2: Brevo HTTPS API. When BREVO_API_KEY is set it is used instead of SMTP.
# MAIL_FROM must be a sender verified in Brevo; it defaults to MAIL_USER.
BREVO_API_KEY=
MAIL_FROM=

# Logos. Without these, everything works and logos are not stored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rebuild the demo account and its invoices every time the server starts
SEED_ON_START=false

# How far the business day is from UTC, in minutes. Left empty, it is 330 (India).
BUSINESS_UTC_OFFSET_MINUTES=

# Optional. Only on a host that puts proxies of its own in front of the server and
# reports the caller in a header the caller cannot set (Render: cf-connecting-ip).
# CONNECTION_IP_HEADER=
